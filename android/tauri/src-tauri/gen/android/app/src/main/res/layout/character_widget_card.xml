<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_card"
    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp"
    android:background="@drawable/widget_card_background" android:clipToOutline="true">
    <ImageView android:id="@+id/widget_portrait" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card_scrim" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:padding="5dp" android:maxLines="1" android:ellipsize="end"
        android:textColor="#ffffff" android:textSize="10sp" android:textStyle="bold" android:importantForAccessibility="no" />
</FrameLayout>
